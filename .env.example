# Copier en .env (ou lancer ./setup.sh qui génère les secrets) puis adapter.

# URL publique, telle que tapée dans le navigateur (sans / final)
PUBLIC_SERVER_URL=http://localhost:3000

# Port HTTP exposé par nginx (sans HTTPS)
HTTP_PORT=3000

# Seuls ces e-mails peuvent créer une organisation (séparés par des virgules).
# Laisser vide permet à n'importe qui de s'inscrire et de créer la sienne.
ALLOWED_ORGANIZATION_ADMINS=dsi@esaat-roubaix.com

# Base de données et stockage
POSTGRES_USER=atlas
POSTGRES_PWD=change-moi
JWT_SECRET_KEY=change-moi
MINIO_USER=minio
MINIO_PASSWORD=change-moi

# Compte de service du formulaire public /demande (à créer dans Atlas avec un rôle « Demandeur »)
DEMANDE_EMAIL=demande@esaat-roubaix.com
DEMANDE_PASSWORD=change-moi

# Couleurs ESAAT (charte de l'intranet). Les couleurs non précisées gardent celles d'Atlas.
CUSTOM_COLORS={"primary":"#292929","primaryAlt":"#3a3634","secondary":"#6e6863","black":"#292929"}

# Options Atlas activées localement par le correctif atlas-api/ (séparées par des virgules)
LOCAL_ENTITLEMENTS=FILE_ATTACHMENTS

# E-mails (désactivés par défaut)
ENABLE_EMAIL_NOTIFICATIONS=false
INVITATION_VIA_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PWD=
SMTP_FROM=

# HTTPS automatique (docker-compose.https.yml) : nom de domaine pointant vers le serveur
DOMAIN=
